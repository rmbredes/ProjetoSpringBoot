<?xml version="1.0" encoding="UTF-8"?>
<!-- Arquivo Maven que descreve o projeto, suas dependências e sua construção. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Versão do modelo de configuração do Maven. -->
    <modelVersion>4.0.0</modelVersion>
    <!-- Herda versões compatíveis e configurações padrão do Spring Boot. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <!-- Busca o projeto pai no repositório Maven, não no disco local. -->
        <relativePath/>
    </parent>
    <!-- Identifica a organização responsável pelo artefato. -->
    <groupId>br.com.exemplo</groupId>
    <!-- Define o nome técnico do artefato gerado. -->
    <artifactId>ProjetoSpringBoot</artifactId>
    <!-- Indica uma versão ainda em desenvolvimento. -->
    <version>0.0.1-SNAPSHOT</version>
    <!-- Nome amigável do projeto. -->
    <name>ProjetoSpringBoot</name>
    <!-- Descrição resumida exibida pelas ferramentas Maven. -->
    <description>ProjetoSpringBoot</description>
    <!-- Metadados opcionais ainda não preenchidos neste projeto de estudo. -->
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <!-- Centraliza propriedades reutilizadas durante a construção. -->
    <properties>
        <!-- Compila e executa o projeto com Java 21. -->
        <java.version>21</java.version>
        <!--
            Versão centralizada do AWS SDK para Java.

            Centralizar a versão evita escrever o mesmo número em cada dependência
            e facilita uma atualização futura.
        -->
        <aws.sdk.version>2.54.8</aws.sdk.version>

        <!--
            Versão do conjunto Spring Cloud compatível com o Spring Boot 4.1.

            Utilizamos uma propriedade para manter a versão centralizada,
            assim como já fazemos com o AWS SDK.
        -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>
    </properties>

    <!--
    dependencyManagement define como as versões das dependências serão escolhidas.

    Esta seção não adiciona o AWS SDK diretamente à aplicação. Ela apenas informa
    ao Maven que todos os módulos da AWS devem utilizar versões compatíveis entre si.
-->
    <dependencyManagement>
        <dependencies>
            <!--
                BOM significa Bill of Materials.

                O BOM reúne as versões compatíveis dos módulos do AWS SDK.
                Por causa dele, não precisaremos declarar uma versão separada
                nas dependências s3, sts e signin.
            -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>

                <!-- Informa que esta dependência contém gerenciamento de versões. -->
                <type>pom</type>

                <!-- Importa as versões definidas pelo BOM para este projeto. -->
                <scope>import</scope>
            </dependency>

            <!-- BOM do Spring Cloud. -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <!-- Lista as bibliotecas disponíveis para compilação, execução e testes. -->
    <dependencies>
        <!-- Fornece o núcleo, a inicialização automática e o sistema de logs do Spring Boot. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Reúne JUnit, Mockito e ferramentas gerais de teste do Spring Boot. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Executa um PostgreSQL real e descartável durante os testes
            que iniciam o contexto Spring e precisam de persistência.

            A versão é administrada pelo parent do Spring Boot,
            portanto não declaramos um número manualmente.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Cria APIs HTTP com Spring MVC e servidor incorporado. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Habilita validações declarativas como @NotNull e @Valid. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Integra JPA, Hibernate e repositórios Spring Data. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Fornece autenticação, autorização e a cadeia de filtros de segurança. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Valida tokens JWT recebidos como credenciais Bearer. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Fornece assinatura, codificação e leitura de JWT no padrão JOSE. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
        <!-- Disponibiliza utilitários de segurança específicos para os testes. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Permite testar controladores MVC de forma isolada com MockMvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Disponibiliza o driver PostgreSQL durante a execução. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Integra o Spring Data ao Redis. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Habilita a abstração de cache e suas anotações. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <!-- Integra produtores, consumers e administração do Apache Kafka. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!--
            Implementação não reativa do Spring Cloud Circuit Breaker.

            O projeto utiliza RestClient, que realiza chamadas síncronas,
            portanto não precisamos do starter Reactor.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!--
            Adiciona os recursos operacionais do Spring Boot Actuator.

            O Actuator fornece endpoints para observar a aplicação,
            incluindo saúde, métricas e informações operacionais.

            O projeto também utiliza sua integração com Micrometer e Prometheus.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Habilita tracing com Micrometer e OpenTelemetry.

            O Spring Boot cria automaticamente o tracer e os componentes
            necessários para acompanhar requisições observadas.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>

        <!--
        Adiciona o registrador do Micrometer específico para Prometheus.

        Quando esta dependência está no classpath, o Spring Boot
        cria automaticamente o PrometheusMeterRegistry e disponibiliza
        o endpoint /actuator/prometheus quando ele estiver exposto.
    -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!--
            Cliente do Amazon S3.

            Será usado para:
            - enviar arquivos;
            - consultar metadados;
            - baixar arquivos;
            - excluir arquivos;
            - gerar URLs temporárias.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!--
            Cliente do Amazon Simple Queue Service (SQS).

            Utilizaremos diretamente o AWS SDK para tornar visíveis
            as operações principais da fila:
            - enviar uma mensagem;
            - receber uma mensagem;
            - excluir uma mensagem depois do processamento.

            A versão será fornecida pelo BOM do AWS SDK declarado acima.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
        </dependency>

        <!--
            Cliente do Amazon Simple Notification Service (SNS).

            Nesta primeira etapa, ele será usado somente para publicar
            o evento que informa a disponibilidade de um relatório.
            O próprio SNS entregará a mensagem aos assinantes do tópico.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sns</artifactId>
        </dependency>

        <!--
            Biblioteca utilizada para criar o relatório em PDF.

            O arquivo será pequeno porque utilizaremos somente texto,
            formas simples e fontes padrão do próprio formato PDF.
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>

        <!--
            Cliente do AWS Security Token Service (STS).

            O STS permite que a aplicação assuma temporariamente a role
            ProjetoSpringBootS3DevRole, evitando chaves permanentes no projeto.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
        </dependency>

        <!--
            Suporte ao login temporário do AWS CLI.

            Essa dependência permite que o SDK reconheça a sessão criada pelo
            comando "aws login", utilizada pelo perfil local projeto-s3.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>signin</artifactId>
        </dependency>

    </dependencies>

    <!-- Configura como o artefato final será construído. -->
    <build>
        <!-- Lista os plugins executados pelo Maven. -->
        <plugins>
            <!-- Empacota a aplicação e suas dependências em um JAR executável. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
